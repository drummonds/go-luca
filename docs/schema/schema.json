    {
      "name": "public.contract_ledger_eod_positions",
      "type": "VIEW",
      "columns": [
        {
          "name": "account_id",
          "type": "text",
          "nullable": true
        },
        {
          "name": "accrued",
          "type": "numeric",
          "nullable": true
        },
        {
          "name": "balance",
          "type": "numeric",
          "nullable": true
        },
        {
          "name": "commodity",
          "type": "varchar(50)",
          "nullable": true
        },
        {
          "name": "day",
          "type": "timestamp without time zone",
          "nullable": true
        },
        {
          "name": "full_path",
          "type": "varchar(500)",
          "nullable": true
        }
      ],
      "def": "CREATE VIEW contract_ledger_eod_positions AS (\n SELECT p.account_id,\n    a.full_path,\n    a.commodity,\n    p.balance_date AS day,\n    round(((p.balance)::numeric / (c.unit)::numeric), (- c.exponent)) AS balance,\n    round((((p.accrued_num)::numeric / (p.accrued_den)::numeric) / (c.unit)::numeric), 7) AS accrued\n   FROM ((balances_live p\n     JOIN accounts a ON ((a.id = p.account_id)))\n     JOIN commodities c ON (((c.code)::text = (a.commodity)::text)))\n)",
      "referenced_tables": [
        "public.balances_live",
        "public.accounts",
        "public.commodities"
      ]
    },
    {
      "name": "public.contract_ledger_live_positions",
      "type": "VIEW",
      "columns": [
        {
          "name": "account_id",
          "type": "text",
          "nullable": true
        },
        {
          "name": "accrued",
          "type": "numeric",
          "nullable": true
        },
        {
          "name": "balance",
          "type": "numeric",
          "nullable": true
        },
        {
          "name": "commodity",
          "type": "varchar(50)",
          "nullable": true
        },
        {
          "name": "full_path",
          "type": "varchar(500)",
          "nullable": true
        }
      ],
      "def": "CREATE VIEW contract_ledger_live_positions AS (\n SELECT account_id,\n    full_path,\n    commodity,\n    round((balance_minor / (unit)::numeric), (- exponent)) AS balance,\n    round((((accrued_num)::numeric / (accrued_den)::numeric) / (unit)::numeric), 7) AS accrued\n   FROM ( SELECT a.id AS account_id,\n            a.full_path,\n            a.commodity,\n            c.unit,\n            c.exponent,\n            (((COALESCE(p.balance, (0)::bigint))::numeric + COALESCE(( SELECT sum(m.amount) AS sum\n                   FROM movements m\n                  WHERE ((m.to_account_id = a.id) AND (m.value_time \u003e= COALESCE(p.next_day, '0001-01-01 00:00:00'::timestamp without time zone)))), (0)::numeric)) - COALESCE(( SELECT sum(m.amount) AS sum\n                   FROM movements m\n                  WHERE ((m.from_account_id = a.id) AND (m.value_time \u003e= COALESCE(p.next_day, '0001-01-01 00:00:00'::timestamp without time zone)))), (0)::numeric)) AS balance_minor,\n            COALESCE(p.accrued_num, (0)::bigint) AS accrued_num,\n            COALESCE(p.accrued_den, (1)::bigint) AS accrued_den\n           FROM ((accounts a\n             JOIN commodities c ON (((c.code)::text = (a.commodity)::text)))\n             LEFT JOIN balances_live p ON (((p.account_id = a.id) AND (p.balance_date = ( SELECT max(q.balance_date) AS max\n                   FROM balances_live q\n                  WHERE (q.account_id = a.id))))))) l\n)",
      "referenced_tables": [
        "public.movements",
        "public.accounts",
        "public.commodities",
        "public.balances_live"
      ]
    },
    {
      "name": "public.contract_ledger_movements",
      "type": "VIEW",
      "columns": [
        {
          "name": "amount",
          "type": "bigint",
          "nullable": true
        },
        {
          "name": "code",
          "type": "varchar(14)",
          "nullable": true
        },
        {
          "name": "description",
          "type": "varchar(500)",
          "nullable": true
        },
        {
          "name": "from_account_id",
          "type": "text",
          "nullable": true
        },
        {
          "name": "from_path",
          "type": "varchar(500)",
          "nullable": true
        },
        {
          "name": "id",
          "type": "text",
          "nullable": true
        },
        {
          "name": "knowledge_time",
          "type": "timestamp without time zone",
          "nullable": true
        },
        {
          "name": "to_account_id",
          "type": "text",
          "nullable": true
        },
        {
          "name": "to_path",
          "type": "varchar(500)",
          "nullable": true
        },
        {
          "name": "value_time",
          "type": "timestamp without time zone",
          "nullable": true
        }
      ],
      "def": "CREATE VIEW contract_ledger_movements AS (\n SELECT m.id,\n    m.from_account_id,\n    m.to_account_id,\n    fa.full_path AS from_path,\n    ta.full_path AS to_path,\n    m.amount,\n    m.code,\n    m.value_time,\n    m.knowledge_time,\n    m.description\n   FROM ((movements m\n     JOIN accounts fa ON ((fa.id = m.from_account_id)))\n     JOIN accounts ta ON ((ta.id = m.to_account_id)))\n)",
      "referenced_tables": [
        "public.movements",
        "public.accounts"
      ]
    },
