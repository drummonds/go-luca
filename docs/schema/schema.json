{
  "name": "go-luca",
  "desc": "Movement-based double-entry bookkeeping database schema",
  "tables": [
    {
      "name": "public.accounts",
      "type": "BASE TABLE",
      "comment": "Chart of accounts. Each account has a hierarchical path (Type:Product:AccountID:Address) and belongs to one of five fundamental types: Asset, Liability, Equity, Income, Expense. An account optionally belongs to a customer (many accounts per customer). Amounts are stored as integers at the precision defined by the commodity's exponent.\n",
      "columns": [
        {
          "name": "account_id",
          "type": "varchar(100)",
          "nullable": false,
          "default": "''::character varying",
          "comment": "Specific account identifier within the product"
        },
        {
          "name": "account_type",
          "type": "varchar(50)",
          "nullable": false,
          "comment": "One of: Asset, Liability, Equity, Income, Expense"
        },
        {
          "name": "address",
          "type": "varchar(100)",
          "nullable": false,
          "default": "''::character varying",
          "comment": "Sub-address within the account (e.g. branch). 'Pending' marks pending accounts"
        },
        {
          "name": "commodity",
          "type": "varchar(50)",
          "nullable": false,
          "default": "'GBP'::character varying",
          "comment": "Commodity code (FK to commodities.code)"
        },
        {
          "name": "created_at",
          "type": "timestamp without time zone",
          "nullable": true,
          "default": "now()",
          "comment": "Timestamp when the account was created"
        },
        {
          "name": "customer_id",
          "type": "text",
          "nullable": true,
          "comment": "Optional owning customer (FK to customers.id). A customer may have many accounts"
        },
        {
          "name": "full_path",
          "type": "varchar(500)",
          "nullable": false,
          "comment": "Hierarchical account path, e.g. Asset:Bank:Current:Main"
        },
        {
          "name": "gross_interest_rate",
          "type": "numeric(10,6)",
          "nullable": false,
          "default": "0",
          "comment": "Gross annual interest rate as a decimal (0.045 = 4.5%)"
        },
        {
          "name": "id",
          "type": "text",
          "nullable": false,
          "comment": "UUID primary key"
        },
        {
          "name": "interest_accumulator",
          "type": "bigint",
          "nullable": false,
          "default": "0",
          "comment": "Sub-unit fractions at extended precision (method-dependent)"
        },
        {
          "name": "interest_method",
          "type": "varchar(20)",
          "nullable": false,
          "default": "''::character varying",
          "comment": "Interest calculation method (e.g. simple_daily)"
        },
        {
          "name": "is_pending",
          "type": "boolean",
          "nullable": true,
          "default": "false",
          "comment": "True if this is a pending/suspense account"
        },
        {
          "name": "opened_at",
          "type": "timestamp without time zone",
          "nullable": true,
          "comment": "When the account was opened"
        },
        {
          "name": "product",
          "type": "varchar(100)",
          "nullable": false,
          "default": "''::character varying",
          "comment": "Product category within the account type"
        }
      ],
      "indexes": [
        {
          "name": "accounts_full_path_key",
          "def": "CREATE UNIQUE INDEX accounts_full_path_key ON public.accounts USING btree (full_path)",
          "table": "public.accounts",
          "columns": [
            "full_path"
          ]
        },
        {
          "name": "accounts_pkey",
          "def": "CREATE UNIQUE INDEX accounts_pkey ON public.accounts USING btree (id)",
          "table": "public.accounts",
          "columns": [
            "id"
          ]
        }
      ],
      "constraints": [
        {
          "name": "accounts_commodity_fkey",
          "type": "FOREIGN KEY",
          "def": "FOREIGN KEY (commodity) REFERENCES commodities(code)",
          "table": "public.accounts",
          "referenced_table": "public.commodities",
          "columns": [
            "commodity"
          ],
          "referenced_columns": [
            "code"
          ]
        },
        {
          "name": "accounts_customer_id_fkey",
          "type": "FOREIGN KEY",
          "def": "FOREIGN KEY (customer_id) REFERENCES customers(id)",
          "table": "public.accounts",
          "referenced_table": "public.customers",
          "columns": [
            "customer_id"
          ],
          "referenced_columns": [
            "id"
          ]
        },
        {
          "name": "accounts_full_path_key",
          "type": "UNIQUE",
          "def": "UNIQUE (full_path)",
          "table": "public.accounts",
          "referenced_table": "",
          "columns": [
            "full_path"
          ]
        },
        {
          "name": "accounts_pkey",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "public.accounts",
          "referenced_table": "",
          "columns": [
            "id"
          ]
        }
      ]
    },
    {
