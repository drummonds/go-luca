    {
      "name": "public.balances_live",
      "type": "BASE TABLE",
      "comment": "Pre-computed end-of-day balance snapshots for today and tomorrow only. Holds at most two days of balances per account — older entries are pruned. Updated transactionally when movements are recorded via RecordMovementWithProjections. Avoids expensive SUM queries for frequently accessed current and projected balances.\n",
      "columns": [
        {
          "name": "account_id",
          "type": "text",
          "nullable": false,
          "comment": "Account this balance belongs to (FK to accounts.id)"
        },
        {
          "name": "accrued_den",
          "type": "bigint",
          "nullable": false,
          "default": "1"
        },
        {
          "name": "accrued_num",
          "type": "bigint",
          "nullable": false,
          "default": "0"
        },
        {
          "name": "balance",
          "type": "bigint",
          "nullable": false,
          "comment": "End-of-day balance in smallest currency unit"
        },
        {
          "name": "balance_date",
          "type": "timestamp without time zone",
          "nullable": false,
          "comment": "Date of the balance snapshot (start of day)"
        },
        {
          "name": "id",
          "type": "text",
          "nullable": false,
          "comment": "UUID primary key"
        },
        {
          "name": "next_day",
          "type": "timestamp without time zone",
          "nullable": true
        },
        {
          "name": "updated_at",
          "type": "timestamp without time zone",
          "nullable": true,
          "default": "now()",
          "comment": "When this balance was last recomputed"
        }
      ],
      "indexes": [
        {
          "name": "balances_live_pkey",
          "def": "CREATE UNIQUE INDEX balances_live_pkey ON public.balances_live USING btree (id)",
          "table": "public.balances_live",
          "columns": [
            "id"
          ]
        },
        {
          "name": "idx_balances_live_unique",
          "def": "CREATE UNIQUE INDEX idx_balances_live_unique ON public.balances_live USING btree (account_id, balance_date)",
          "table": "public.balances_live",
          "columns": [
            "account_id",
            "balance_date"
          ]
        }
      ],
      "constraints": [
        {
          "name": "balances_live_account_id_fkey",
          "type": "FOREIGN KEY",
          "def": "FOREIGN KEY (account_id) REFERENCES accounts(id)",
          "table": "public.balances_live",
          "referenced_table": "public.accounts",
          "columns": [
            "account_id"
          ],
          "referenced_columns": [
            "id"
          ]
        },
        {
          "name": "balances_live_pkey",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "public.balances_live",
          "referenced_table": "",
          "columns": [
            "id"
          ]
        }
      ]
    },
    {
      "name": "public.commodities",
      "type": "BASE TABLE",
      "comment": "Currency/commodity definitions. Each commodity has a unique code and an exponent that defines the precision of amounts (e.g. -2 for pence). Accounts reference commodities via foreign key.\n",
      "columns": [
        {
          "name": "code",
          "type": "varchar(50)",
          "nullable": false,
          "comment": "Unique commodity code (e.g. GBP, USD, BTC)"
        },
        {
          "name": "created_at",
          "type": "timestamp without time zone",
          "nullable": true,
          "default": "now()",
          "comment": "Timestamp when the commodity was created"
        },
        {
          "name": "datetime",
          "type": "timestamp without time zone",
          "nullable": true,
          "comment": "Optional date associated with the commodity definition"
        },
        {
          "name": "exponent",
          "type": "integer",
          "nullable": false,
          "default": "'-2'::integer",
          "comment": "Decimal exponent for amount precision (-2 = pence, -8 = satoshi)"
        },
        {
          "name": "id",
          "type": "text",
          "nullable": false,
          "comment": "UUID primary key"
        },
        {
          "name": "unit",
          "type": "bigint",
          "nullable": false,
          "default": "0"
        }
      ],
      "indexes": [
        {
